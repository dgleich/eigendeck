<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated Info.plist by tauri-bundler on macOS builds. We declare
  the .eigendeck document type here (instead of relying on the `fileAssociations`
  autogeneration) so we can point it at a custom icon via CFBundleTypeIconFile —
  Tauri's fileAssociations has no icon field. The icon file itself (eigendeck-doc.icns)
  ships via bundle.resources. See docs/mac-native-toolbar.md / issue #130.
  (fileAssociations in tauri.conf.json still drives the Linux/Windows associations.)

  It also carries the App Transport Security exception that lets WKWebView load the
  YouTube loopback shim's plain-http subframe (http://127.0.0.1:<port>). The exception
  is SCOPED to 127.0.0.1 + localhost — NOT the global NSAllowsArbitraryLoadsInWebContent
  — so ATS keeps enforcing https for every other host, preserving the network
  containment of the demo/notebook/html iframes. See docs/youtube-embed-shim.md / #152.
-->
<plist version="1.0">
<dict>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSExceptionDomains</key>
    <dict>
      <key>127.0.0.1</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <true/>
      </dict>
      <key>localhost</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <true/>
      </dict>
    </dict>
  </dict>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Eigendeck Presentation</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>eigendeck</string>
      </array>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>CFBundleTypeIconFile</key>
      <string>eigendeck-doc</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
    </dict>
  </array>
</dict>
</plist>
