{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eigendeck",
  "version": "26.7.9",
  "identifier": "dev.eigendeck.Eigendeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eigendeck",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false,
        "scope": {
          "allow": [],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium/*": "resources/pdfium/",
      "resources/llm-tools/*": "resources/llm-tools/",
      "Credits.html": "Credits.html",
      "icons/document/eigendeck-doc.icns": "eigendeck-doc.icns"
    },
    "fileAssociations": [
      {
        "ext": [
          "eigendeck"
        ],
        "name": "Eigendeck Presentation",
        "description": "Eigendeck presentation document",
        "mimeType": "application/x-eigendeck",
        "role": "Editor"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
