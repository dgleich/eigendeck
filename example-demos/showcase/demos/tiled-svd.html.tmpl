<!DOCTYPE html>
<!--eigendeck-demo-v1-->
<html lang="en">
<head>
<meta charset="utf-8">
<title>Tiled-SVD image compression</title>
<!--
  Showcase demo — low-rank image compression two ways, at the SAME storage
  budget. LEFT: plain SVD of the whole image. RIGHT: SVD of the image
  reorganized into a "matrix of tiles" (each t×t tile vectorized into a column).
  Drag the storage slider — both reconstructions update live and report their
  rank / numbers-kept / error. At equal storage the tiled reorganization wins,
  because natural images repeat local structure across tiles.

  Method + result from David F. Gleich, "Better than best low-rank approximation
  with the singular value decomposition", arXiv:2402.18427 (Figure 1).

  Title-LESS, theme-aware, interaction-first. Transparent over the slide; the
  grayscale photos are public-domain test images (scikit-image: camera, text,
  moon). Embedded as raw bytes; the SVDs are computed live in JS.
-->
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 100%; height: 100%; }
  body {
    overflow: hidden;
    background: var(--eigendeck-bg, #ffffff);
    color: var(--eigendeck-fg, #222222);
    font-family: var(--eigendeck-font, 'PT Sans'), system-ui, sans-serif;
    font-size: var(--eigendeck-base-size, 22px);
    display: flex; flex-direction: column; padding: 1em 1.4em;
  }
  .ts-panels { flex: 1; min-height: 0; display: flex; gap: 1.6em; align-items: stretch; justify-content: center; }
  .ts-panel { display: flex; flex-direction: column; align-items: center; gap: 0.5em; flex: 0 1 auto; min-width: 0; }
  .ts-frame { position: relative; flex: 1; min-height: 0; aspect-ratio: 1 / 1; border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--eigendeck-fg, #333) 28%, transparent);
    overflow: hidden; background: color-mix(in srgb, var(--eigendeck-fg, #333) 6%, transparent); }
  .ts-frame canvas { width: 100%; height: 100%; display: block; image-rendering: auto; }
  /* FIXED caption height + non-wrapping lines → all three frames stay the SAME
     size, and the Original frame never resizes (so it doesn't re-upscale and look
     like it "degrades") as the stat text changes with the storage slider. */
  .ts-cap { flex: 0 0 auto; height: 2.9em; text-align: center; line-height: 1.25; overflow: hidden; }
  .ts-cap .ts-name { font-size: 0.74em; font-weight: 700; color: var(--eigendeck-heading, var(--eigendeck-fg, #222)); }
  .ts-cap .ts-stat { font-size: 0.6em; white-space: nowrap; color: var(--eigendeck-muted, #888); }
  .ts-cap .ts-err { font-weight: 700; }
  .ts-cap.win .ts-err { color: var(--eigendeck-accent, #2563eb); }
  .ts-arrow { align-self: center; font-size: 1.2em; color: var(--eigendeck-muted, #aaa); padding: 0 0.1em; }

  .ts-ctrl { flex: 0 0 auto; display: flex; align-items: center; gap: 1.4em; margin-top: 0.8em; flex-wrap: wrap; justify-content: center; }
  .ts-row { display: flex; align-items: center; gap: 0.55em; font-size: 0.62em; color: var(--eigendeck-muted, #888); }
  .ts-row .ts-lab { white-space: nowrap; }
  .ts-row input[type=range] { width: 12em; accent-color: var(--eigendeck-accent, #2563eb);
    background: color-mix(in srgb, var(--eigendeck-fg, #333) 20%, transparent); border-radius: 4px; height: 0.35em; }
  .ts-budget { font-weight: 700; color: var(--eigendeck-fg, #222); font-variant-numeric: tabular-nums; }
  .ts-seg { display: inline-flex; border: 1px solid color-mix(in srgb, var(--eigendeck-fg, #333) 26%, transparent); border-radius: 6px; overflow: hidden; }
  .ts-seg button { font-family: inherit; font-size: 1em; cursor: pointer; border: 0; background: transparent;
    color: var(--eigendeck-fg, #222); padding: 0.25em 0.7em; }
  .ts-seg button.on { background: var(--eigendeck-accent, #2563eb); color: #fff; }
  .ts-cite { position: absolute; right: 1.4em; bottom: 0.5em; font-size: 0.5em; color: var(--eigendeck-muted, #aaa); }
  .ts-cite a { color: inherit; text-decoration: none; }
  /* "computing…" overlay shown while the (exact) plain SVD runs on a load/image change */
  .ts-solving { position: absolute; inset: 0; display: none; align-items: center; justify-content: center;
    font-size: 0.8em; color: var(--eigendeck-muted, #888); z-index: 5;
    background: color-mix(in srgb, var(--eigendeck-bg, #fff) 60%, transparent); }
  .ts-solving.on { display: flex; }
</style>
</head>
<body>
  <div class="ts-solving" id="ts-solving">computing the SVD …</div>
  <div class="ts-panels">
    <div class="ts-panel">
      <div class="ts-frame"><canvas id="cv-orig"></canvas></div>
      <div class="ts-cap"><div class="ts-name">Original</div><div class="ts-stat" id="st-orig">384×384 · 147,456 numbers</div></div>
    </div>
    <div class="ts-arrow">→</div>
    <div class="ts-panel">
      <div class="ts-frame"><canvas id="cv-plain"></canvas></div>
      <div class="ts-cap" id="cap-plain"><div class="ts-name">Plain SVD</div><div class="ts-stat" id="st-plain">—</div></div>
    </div>
    <div class="ts-panel">
      <div class="ts-frame"><canvas id="cv-tiled"></canvas></div>
      <div class="ts-cap" id="cap-tiled"><div class="ts-name">Tiled SVD &nbsp;<span style="font-weight:400">(matrix of tiles)</span></div><div class="ts-stat" id="st-tiled">—</div></div>
    </div>
  </div>

  <div class="ts-ctrl">
    <div class="ts-row"><span class="ts-lab">storage</span>
      <input id="ts-budget" type="range" min="4000" max="36000" step="500" value="12000">
      <span class="ts-budget" id="ts-budgetv">4,000</span><span class="ts-lab">numbers</span>
    </div>
    <div class="ts-row"><span class="ts-lab">tile</span>
      <span class="ts-seg" id="ts-tile">
        <button data-t="8" class="on">8×8</button><button data-t="16">16×16</button>
      </span>
    </div>
    <div class="ts-row"><span class="ts-lab">image</span>
      <span class="ts-seg" id="ts-img">
        <button data-i="camera" class="on">Cameraman</button><button data-i="text">Text</button><button data-i="moon">Moon</button>
      </span>
    </div>
  </div>
  <div class="ts-cite">SVD of a <b>matrix of tiles</b> · Gleich, <a href="https://arxiv.org/abs/2402.18427">arXiv:2402.18427</a></div>

<script>/* __SVDJS__ */</script>
<script>
(function () {
  'use strict';
  if (typeof SVDJS === 'undefined' || !SVDJS.SVD) return;   // svd-js (Golub–Reinsch) injected at build into the slot above
  var IMAGES = {"camera": {"w": 384, "h": 384, "label": "Cameraman", "data": ""}, "text": {"w": 384, "h": 384, "label": "Text", "data": ""}, "moon": {"w": 384, "h": 384, "label": "Moon", "data": ""}};
  var N = 384;

  function tv(n, fb) { try { return getComputedStyle(document.documentElement).getPropertyValue(n).trim() || fb; } catch (e) { return fb; } }
  function b64ToBytes(b64) { var bin = atob(b64), a = new Uint8Array(bin.length); for (var i = 0; i < bin.length; i++) a[i] = bin.charCodeAt(i); return a; }

  // ---- linear algebra: truncated SVD via the smaller Gram matrix ----
  // Exact SVD via the vendored svd-js (Golub–Reinsch). A is p×q row-major;
  // returns {sv,U,Vt} sorted desc, up to kmax components (U[c]∈R^p, Vt[c]∈R^q).
  // svd-js requires rows ≥ cols, so transpose when p<q and swap U/V back.
  function svd(A, p, q, kmax) {
    var trans = p < q, m = trans ? q : p, n = trans ? p : q, mat = [], i, j;
    for (i = 0; i < m; i++) {
      var row = new Array(n);
      if (trans) { for (j = 0; j < n; j++) row[j] = A[j * q + i]; }   // row i of Aᵀ
      else { for (j = 0; j < n; j++) row[j] = A[i * q + j]; }
      mat.push(row);
    }
    var res = SVDJS.SVD(mat, true, true);                              // {u:m×n, v:n×n, q:n} (q unsorted, ≥0)
    var order = res.q.map(function (s, idx) { return idx; }).sort(function (x, y) { return res.q[y] - res.q[x]; });
    var K = Math.min(kmax, n), sv = [], U = [], Vt = [];
    for (var c = 0; c < K; c++) {
      var e = order[c], sigma = res.q[e]; if (sigma < 1e-7) break;
      var uC = new Float64Array(p), vC = new Float64Array(q);
      // !trans: A = u Σ vᵀ → left=u cols (R^p), right=v cols (R^q)
      // trans:  Aᵀ = u Σ vᵀ → A = v Σ uᵀ → left=v cols (R^p), right=u cols (R^q)
      if (trans) { for (i = 0; i < p; i++) uC[i] = res.v[i][e]; for (j = 0; j < q; j++) vC[j] = res.u[j][e]; }
      else { for (i = 0; i < p; i++) uC[i] = res.u[i][e]; for (j = 0; j < q; j++) vC[j] = res.v[j][e]; }
      sv.push(sigma); U.push(uC); Vt.push(vC);
    }
    return { sv: sv, U: U, Vt: Vt };
  }
  function reconInto(out, res, p, q, r) {
    out.fill(0); var R = Math.min(r, res.sv.length);
    for (var c = 0; c < R; c++) { var sg = res.sv[c], u = res.U[c], v = res.Vt[c]; for (var i = 0; i < p; i++) { var su = sg * u[i]; for (var j = 0; j < q; j++) out[i * q + j] += su * v[j]; } }
  }
  function relErr(a, b, n) { var e = 0, d = 0; for (var i = 0; i < n; i++) { var t = a[i] - b[i]; e += t * t; d += b[i] * b[i]; } return Math.sqrt(e / d); }

  // ---- tiling ----
  function toTiles(g, t) {
    var tn = N / t, numTiles = tn * tn, m = t * t, T = new Float64Array(m * numTiles), col = 0;
    for (var ty = 0; ty < tn; ty++) for (var tx = 0; tx < tn; tx++) {
      for (var yy = 0; yy < t; yy++) for (var xx = 0; xx < t; xx++) T[(yy * t + xx) * numTiles + col] = g[(ty * t + yy) * N + (tx * t + xx)];
      col++;
    }
    return { T: T, m: m, numTiles: numTiles, tn: tn };
  }
  function fromTiles(That, m, numTiles, tn, t, out) {
    var col = 0;
    for (var ty = 0; ty < tn; ty++) for (var tx = 0; tx < tn; tx++) {
      for (var yy = 0; yy < t; yy++) for (var xx = 0; xx < t; xx++) out[(ty * t + yy) * N + (tx * t + xx)] = That[(yy * t + xx) * numTiles + col];
      col++;
    }
  }

  // ---- state + precompute ----
  var curImg = 'camera', curTile = 8;
  var gray = null;                 // Float64Array N*N, 0..1 (the original)
  var plainSvd = null, tileSvd = null, tileInfo = null;
  var bufPlain = new Float64Array(N * N), bufTile = null, bufTileImg = new Float64Array(N * N);

  function loadImage(name) {
    var bytes = b64ToBytes(IMAGES[name].data);
    gray = new Float64Array(N * N);
    for (var i = 0; i < N * N; i++) gray[i] = bytes[i] / 255;
  }
  // The plain SVD is the expensive part (a full N×N decomposition). Split it out
  // so only an IMAGE change pays for it — tile/budget changes reuse it. `full`
  // recomputes plain too; otherwise just the (cheap) tiled SVD.
  function recompute(full) {
    if (full) plainSvd = svd(gray, N, N, 64);
    tileInfo = toTiles(gray, curTile);
    tileSvd = svd(tileInfo.T, tileInfo.m, tileInfo.numTiles, Math.min(tileInfo.m, tileInfo.numTiles));
    bufTile = new Float64Array(tileInfo.m * tileInfo.numTiles);
  }

  // ---- drawing ----
  // Each paint uses its OWN offscreen canvas. A single shared offscreen is a
  // WebKit hazard: WKWebView defers drawImage rasterization, so by the time the
  // copy actually happens the shared buffer already holds the NEXT pane's
  // pixels — painting orig→plain→tiled then shows each pane the next one's image
  // (orig shows plain, plain & tiled both show tiled). A fresh, never-mutated
  // offscreen per call makes the deferred draw read the correct content.
  function paint(canvas, data) {
    var off = document.createElement('canvas'); off.width = N; off.height = N;
    var offCtx = off.getContext('2d'), offImg = offCtx.createImageData(N, N), d = offImg.data;
    for (var i = 0; i < N * N; i++) { var v = Math.max(0, Math.min(255, Math.round(data[i] * 255))); d[i * 4] = v; d[i * 4 + 1] = v; d[i * 4 + 2] = v; d[i * 4 + 3] = 255; }
    offCtx.putImageData(offImg, 0, 0);
    var ctx = canvas.getContext('2d'), dpr = window.devicePixelRatio || 1, r = canvas.getBoundingClientRect();
    var W = Math.max(1, Math.round(r.width * dpr)), H = Math.max(1, Math.round(r.height * dpr));
    if (canvas.width !== W || canvas.height !== H) { canvas.width = W; canvas.height = H; }
    ctx.imageSmoothingEnabled = true; ctx.clearRect(0, 0, W, H); ctx.drawImage(off, 0, 0, W, H);
  }
  function fmt(n) { return n.toLocaleString('en-US'); }

  var cvOrig = document.getElementById('cv-orig'), cvPlain = document.getElementById('cv-plain'), cvTiled = document.getElementById('cv-tiled');
  var stPlain = document.getElementById('st-plain'), stTiled = document.getElementById('st-tiled');
  var capPlain = document.getElementById('cap-plain'), capTiled = document.getElementById('cap-tiled');
  var budgetEl = document.getElementById('ts-budget'), budgetV = document.getElementById('ts-budgetv');

  function render() {
    var budget = parseInt(budgetEl.value, 10);
    budgetV.textContent = fmt(budget);
    // plain: params = r*(N+N); tiled: params = r*(m+numTiles)
    var perPlain = N + N, perTile = tileInfo.m + tileInfo.numTiles;
    var rP = Math.max(1, Math.floor(budget / perPlain));
    var rT = Math.max(1, Math.floor(budget / perTile));
    rP = Math.min(rP, plainSvd.sv.length); rT = Math.min(rT, tileSvd.sv.length);

    reconInto(bufPlain, plainSvd, N, N, rP);
    reconInto(bufTile, tileSvd, tileInfo.m, tileInfo.numTiles, rT);
    fromTiles(bufTile, tileInfo.m, tileInfo.numTiles, tileInfo.tn, curTile, bufTileImg);

    var eP = relErr(bufPlain, gray, N * N), eT = relErr(bufTileImg, gray, N * N);
    paint(cvOrig, gray); paint(cvPlain, bufPlain); paint(cvTiled, bufTileImg);

    stPlain.innerHTML = 'rank ' + rP + ' · ' + fmt(rP * perPlain) + ' numbers · <span class="ts-err">' + (eP * 100).toFixed(1) + '% error</span>';
    stTiled.innerHTML = 'rank ' + rT + ' · ' + fmt(rT * perTile) + ' numbers · <span class="ts-err">' + (eT * 100).toFixed(1) + '% error</span>';
    capPlain.classList.toggle('win', eP < eT);
    capTiled.classList.toggle('win', eT <= eP);
  }

  var solvingEl = document.getElementById('ts-solving');
  // Heavy path (load image + full SVD): show the overlay, then compute on the next
  // tick so the overlay actually paints before the (blocking) decomposition runs.
  function rebuild() {
    loadImage(curImg);
    solvingEl.classList.add('on');
    setTimeout(function () { recompute(true); render(); solvingEl.classList.remove('on'); }, 30);
  }
  function retile() { recompute(false); render(); }   // tile change → tiled SVD only (fast)

  budgetEl.addEventListener('input', render);
  document.getElementById('ts-tile').addEventListener('click', function (e) {
    var b = e.target.closest('button'); if (!b) return;
    curTile = parseInt(b.dataset.t, 10);
    Array.from(this.children).forEach(function (x) { x.classList.toggle('on', x === b); });
    retile();
  });
  document.getElementById('ts-img').addEventListener('click', function (e) {
    var b = e.target.closest('button'); if (!b) return;
    curImg = b.dataset.i;
    Array.from(this.children).forEach(function (x) { x.classList.toggle('on', x === b); });
    rebuild();
  });
  window.addEventListener('resize', function () { if (gray) render(); });
  // repaint on a live deck-theme change (labels track theme; recompute not needed)
  var lastTheme = '';
  setInterval(function () { var sig = tv('--eigendeck-fg', '') + '|' + tv('--eigendeck-accent', ''); if (sig !== lastTheme) { lastTheme = sig; if (gray) render(); } }, 500);

  function start() { rebuild(); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>
</body>
</html>
