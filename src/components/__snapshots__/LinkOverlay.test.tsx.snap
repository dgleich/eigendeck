exports[`[simplify-guard] LinkOverlay render snapshot > renders the static link-target types to a stable DOM 1`] = `"<div class="link-overlay"><div class="link-overlay-content"><div class="link-overlay-header"><span>Click an element on slide 2 to link</span><div class="link-overlay-nav"><button disabled="">←</button><span>Slide 2 / 2</span><button>→</button></div><button class="link-overlay-close">Cancel</button></div><div class="link-overlay-slide-container"><div class="link-overlay-slide" style="width: 1920px; height: 1080px; position: relative; background: rgb(255, 255, 255); transform: scale(0.5); transform-origin: top left;"><div style="position: absolute; left: 60px; top: 40px; width: 800px; height: 120px; cursor: pointer; border: 4px solid transparent; border-radius: 4px; transition: border-color 0.15s; z-index: 10; opacity: 1; pointer-events: auto;" class="link-overlay-element"><div style="width: 100%; height: 100%; font-family: &quot;PT Sans&quot;, sans-serif; font-weight: 700; font-style: normal; font-size: 72px; color: rgb(34, 34, 34); line-height: 1.3; overflow: hidden; padding: 8px 12px; pointer-events: none;">Title</div></div><div style="position: absolute; left: 60px; top: 200px; width: 300px; height: 200px; cursor: not-allowed; border: 4px solid transparent; border-radius: 4px; transition: border-color 0.15s; z-index: 10; opacity: 0.3; pointer-events: none; background: rgb(240, 240, 240); display: flex; align-items: center; justify-content: center; font-size: 48px; color: rgb(170, 170, 170);" class="link-overlay-element">IMG</div><div style="position: absolute; left: 400px; top: 200px; width: 300px; height: 200px; cursor: not-allowed; border: 4px dashed rgb(147, 197, 253); border-radius: 4px; transition: border-color 0.15s; z-index: 10; opacity: 0.3; pointer-events: none; background: rgb(232, 244, 248); display: flex; align-items: center; justify-content: center; font-size: 40px; color: rgb(96, 165, 250);" class="link-overlay-element">DEMO</div><div style="position: absolute; left: 800px; top: 200px; width: 200px; height: 200px; cursor: not-allowed; border: 4px dashed rgb(167, 139, 250); border-radius: 4px; transition: border-color 0.15s; z-index: 10; opacity: 0.3; pointer-events: none; background: rgb(240, 232, 248); display: flex; align-items: center; justify-content: center; font-size: 32px; color: rgb(124, 58, 237);" class="link-overlay-element">fig</div><div style="position: absolute; left: 1200px; top: 500px; width: 300px; height: 200px; cursor: not-allowed; border: 4px solid rgb(221, 221, 221); border-radius: 4px; transition: border-color 0.15s; z-index: 10; opacity: 0.3; pointer-events: none; background: rgb(34, 34, 34);" class="link-overlay-element"></div><div style="position: absolute; left: 70px; top: 470px; width: 360px; height: 80px; cursor: pointer; z-index: 10;" class="link-overlay-element"><svg width="360" height="80" style="overflow: visible;"><line x1="30" y1="30" x2="330" y2="50" stroke="transparent" stroke-width="24" style="pointer-events: stroke;"></line><g opacity="1"><line x1="30" y1="30" x2="316.17428329243376" y2="49.0782855528289" stroke="#e53e3e" stroke-width="4"></line><polygon points="330,50 315.6421312082436,57.060566815681796 316.706435376624,41.096004289976065" fill="#e53e3e"></polygon></g></svg></div></div></div></div></div>"`;
