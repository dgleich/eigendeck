{
  "_about": "Interop corpus: what real apps put on the OS clipboard, and which Eigendeck paste branch each should take. `flavors` are the REAL macOS pasteboard type lists captured this session via Debug > Dump Pasteboard Types (see README). `html`/`plain` bodies are representative of each app's markup (the exact bytes vary per selection); they are shaped to exercise the classifier, not byte-for-byte captures. `expect` is the branch the paste ladder must choose. To add a real capture: paste the dump into a new object here (see README).",
  "_branches": {
    "internal": "Eigendeck private flavor (data-eigendeck-copy + JSON) — decodeClipHtml wins first",
    "image-dataurl": "no clipboard image, but text/html embeds <img src=data:…> — extractPastedDataUrlImage (#158)",
    "image-screenshot": "block HTML a text box can't hold (table/img/svg/pre/math) — htmlNeedsScreenshot → rasterize",
    "text": "styled/plain runs the format toolbar can author — pasteTextToElementHtml → editable text element"
  },
  "cases": [
    {
      "app": "Microsoft Word (macOS) — styled sentence",
      "flavors": ["public.html", "public.rtf", "public.utf8-plain-text"],
      "html": "<meta charset=\"utf-8\"><p style=\"margin:0\"><span style=\"font-family:Calibri;font-size:11pt;color:#000000\">Here is <b>some bold</b> text.</span></p>",
      "plain": "Here is some bold text.",
      "expect": "text"
    },
    {
      "app": "Microsoft Word (macOS) — a table",
      "flavors": ["public.html", "public.rtf", "public.utf8-plain-text"],
      "html": "<meta charset=\"utf-8\"><table><tr><td>a</td><td>b</td></tr><tr><td>c</td><td>d</td></tr></table>",
      "plain": "a\tb\nc\td",
      "expect": "image-screenshot"
    },
    {
      "app": "Google Docs (Chrome) — styled paragraph",
      "flavors": ["public.html", "public.utf8-plain-text", "org.chromium.web-custom-data"],
      "html": "<meta charset=\"utf-8\"><b id=\"docs-internal-guid-5400a67e-7fff-4cf0-ed00-dfea257517fc\" style=\"font-weight:normal\"><p dir=\"ltr\"><span style=\"font-size:11pt;color:#000000\">Docs para with <span style=\"font-style:italic\">italics</span>.</span></p></b>",
      "plain": "Docs para with italics.",
      "expect": "text"
    },
    {
      "app": "Google Slides (Chrome) — copied image (#158)",
